		{
			"name": "00 Init Defaults",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"if (!pm.environment.get('testsrcpath')) pm.environment.set('testsrcpath', '');",
							"if (!pm.environment.get('baseUrl')) pm.environment.set('baseUrl', 'http://localhost:8080/virtualbox/0.0.2');",
							"if (!pm.environment.get('controllerNameSATA')) pm.environment.set('controllerNameSATA', 'SATA');",
							"if (!pm.environment.get('controllerNameIDE')) pm.environment.set('controllerNameIDE', 'IDE');",
							"if (!pm.environment.get('sataPort')) pm.environment.set('sataPort', '0');",
							"if (!pm.environment.get('sataDevice')) pm.environment.set('sataDevice', '0');",
							"if (!pm.environment.get('idePort')) pm.environment.set('idePort', '0');",
							"if (!pm.environment.get('ideDevice')) pm.environment.set('ideDevice', '0');",
							"if (!pm.environment.get('testGroupName')) pm.environment.set('testGroupName', 'VBoxRESTAPI');",
							"if (!pm.environment.get('vmFolderPath')) pm.environment.set('vmFolderPath', '');",
							"if (!pm.environment.get('machineName')) pm.environment.set('machineName', 'VBox-RESTAPI-test');"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						""
					]
				}
			},
			"response": []
		},
