							"pm.test('getServer DVDImages 200', function(){ pm.response.to.have.status(200); });",
							"let responseData = {}; try{ responseData = pm.response.json(); }catch(e){}",
							"const DVDDisks = responseData.server.DVDImages",
							"let fFound = false;",
							"const target = pm.environment.get(\"dvdId\");",
							"",
							"if (Array.isArray(DVDDisks) && DVDDisks.length > 0) {",
							"    DVDDisks.forEach((item, index) => {",
							"        console.log(`Processing item at index ${index}...`);",
							"        pm.expect(item).to.have.property(\"name\");",
							"        pm.expect(item).to.have.property(\"id\");",
							"        if (item.id === target)",
							"        {",
							"            console.log(`id ${item.id} found!`, item);",
							"            fFound = true;",
							"            return; // Use return instead of break",
							"        }",
							"    });",
							"} else {",
							"    console.log(\"Response data is not an array or is empty.\");",
							"}",
							" ",
							"if (fFound) { pm.execution.setNextRequest('11 IMachine::attachDeviceWithoutMedium (IDE/DVD empty)'); }",
							"else { console.warn('DVD image not found: ' + target); pm.execution.setNextRequest(null); }"
