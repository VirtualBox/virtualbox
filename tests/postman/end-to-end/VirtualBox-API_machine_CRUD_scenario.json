						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"settingsFile\": \"\",\n  \"name\": \"{{machineName}}_{{$timestamp}}\",\n  \"platform\": \"X86\",\n  \"groups\": [\n    \"/{{testGroupName}}\"\n  ],\n  \"osTypeId\": \"Oracle9_64\",\n  \"flags\": \"\",\n  \"cipher\": \"\",\n  \"passwordId\": \"\",\n  \"password\": \"\"\n}"
