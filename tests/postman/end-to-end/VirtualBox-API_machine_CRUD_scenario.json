			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('openMedium status 200/201', function(){ pm.expect([200,201]).to.include(pm.response.code); });",
							"let responseData = {}; try{ responseData = pm.response.json(); }catch(e){}",
							"const mediumId = responseData.medium.id",
							"let fFound = false;",
							"console.log(`id ${mediumId} found!`);",
							"pm.environment.set(\"mediumId\", mediumId)"
