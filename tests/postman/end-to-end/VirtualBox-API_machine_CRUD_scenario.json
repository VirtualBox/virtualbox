		{
			"name": "03 IVirtualBox::createMachine",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const path = require('path');",
							"pm.test('createMachine status 200', function(){ pm.response.to.have.status(200); });",
							"var json = pm.response.json();",
							"pm.expect(json).to.have.property(\"id\");",
							"pm.environment.set(\"machineId\", json.id);",
							"pm.expect(json).to.have.property(\"settingsFilePath\");",
    							"pm.environment.set(\"vmFolderPath\", path.dirname(json.settingsFilePath));",
    							"var vmFolderPath = pm.environment.get(\"vmFolderPath\");",
    							"console.log(`vmFolderPath is ${vmFolderPath}`);",
    							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
