		{
			"name": "05 ISynthetic::getServer (hardDisks)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('getServer hardDisks 200', function(){ pm.response.to.have.status(200); });",
							"let responseData = {}; try{ responseData = pm.response.json(); }catch(e){}",
							"const hardDisks = responseData.server.hardDisks",
							"let fFound = false;",
							"const target = pm.environment.get(\"mediumId\");",
							"",
							"if (Array.isArray(hardDisks) && hardDisks.length > 0) {",
							"    hardDisks.forEach((item, index) => {",
							"        console.log(`Processing item at index ${index}...`);",
							"        pm.expect(item).to.have.property(\"name\");",
							"        pm.expect(item).to.have.property(\"id\");",
							"        if (item.id === target)",
							"        {",
							"            console.log(`id ${item.id} found!`, item);",
							"            fFound = true;",
							"            return;",
							"        }",
							"    });",
							"} else {",
							"    console.log(\"Response data is not an array or is empty.\");",
							"}",
							"",
							"if (fFound) { pm.execution.setNextRequest('06 IMachine::attachDevice (HARDDISK→SATA)'); }",
							"else { console.warn('Hard disk not found: ' + target); pm.execution.setNextRequest(null); }"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/server/?select=hardDisks",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"server",
						""
					],
					"query": [
						{
							"key": "select",
							"value": "hardDisks"
						}
					]
				}
			},
			"response": []
		},
