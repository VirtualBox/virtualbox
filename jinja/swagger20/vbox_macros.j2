{% macro try_catch_block(statement, indent=0) -%}
{%- set pad = ' ' * indent %}
{{ pad }}try:
{{ pad }}    {{ statement }}
{{ pad }}except Exception as e:
{{ pad }}    httpCode = HTTPStatus.INTERNAL_SERVER_ERROR
{{ pad }}    oError = Error(httpCode, str(e))
{%- endmacro %}

{% macro jsonify_response_block(obj_name) %}
    {% if obj_name %}
response = jsonify(oError if oError is not None else {{ obj_name }})
    {% else %}
response = jsonify(oError if oError is not None else "Successfull operation")
    {% endif %}
    return response, httpCode
{%- endmacro %}

{% macro to_snake_case(name) -%}
{%- set result = [] -%}
{%- for i in range(0, name|length) -%}
    {%- set c = name[i] -%}
    {%- if i > 0 and c.isupper() -%}
        {%- set result = result + ['_', c.lower()] -%}
    {%- else -%}
        {%- set result = result + [c.lower()] -%}
    {%- endif -%}
{%- endfor -%}
{{ result | join('') }}
{%- endmacro %}

