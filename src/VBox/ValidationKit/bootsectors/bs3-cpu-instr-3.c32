        {  BS3_INSTR3_C64(vmovddup_YMM12_YMM8),  255,         RM_REG, T_AVX_256,  YMM12, YMM8,  PASS_ARRAY(s_aValues) },
        {  BS3_INSTR3_ALL(vmovddup_YMM1_FSxBX),  X86_XCPT_DB, RM_MEM, T_AVX_256,  YMM1,  FSxBX, PASS_ARRAY(s_aValues) },
