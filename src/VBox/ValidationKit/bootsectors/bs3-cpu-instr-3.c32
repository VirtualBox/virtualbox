        {  BS3_INSTR3_ALL(vpgatherdd_XMM0_EBX_plus_0_plus_XMM1_x_1_XMM0),   X86_XCPT_UD, 0,    T_AVX2_128, XMM0, EBX, XMM1, XMM0,  PASS_ARRAY(s_aValuesUD)      },
