        {  BS3_INSTR3_C64(vmovddup_XMM7_XMM14),  255,         RM_REG, T_AVX_128,  XMM7,  XMM14, PASS_ARRAY(s_aValues) },
        {  BS3_INSTR3_ALL(vmovddup_XMM1_FSxBX),  X86_XCPT_AC, RM_MEM, T_AVX_128,  XMM1,  FSxBX, PASS_ARRAY(s_aValues) },
        {  BS3_INSTR3_C64(vmovddup_XMM11_FSxBX), X86_XCPT_AC, RM_MEM, T_AVX_128,  XMM11, FSxBX, PASS_ARRAY(s_aValues) },

