        {  BS3_INSTR3_C64(vpermpd_YMM8_YMM9_0E7h),  255,         RM_REG, T_AVX2_256, YMM8, YMM9,  NOREG, PASS_ARRAY(s_aValuesE7) },
        {  BS3_INSTR3_C64(vpermpd_YMM8_FSxBX_0E7h), X86_XCPT_DB, RM_MEM, T_AVX2_256, YMM8, FSxBX, NOREG, PASS_ARRAY(s_aValuesE7) },
        {  BS3_INSTR3_C64(vpermpd_YMM8_RIPREL_0E7h), X86_XCPT_DB, RM_MEM, T_AVX2_256, YMM8, RIPREL, NOREG, PASS_ARRAY(s_aValuesE7) },

        {  BS3_INSTR3_ALL(vpermpd_YMM1_YMM1_000h),  255,         RM_REG, T_AVX2_256, YMM1, YMM1,  NOREG, PASS_ARRAY(s_aValues00) },
        {  BS3_INSTR3_ALL(vpermpd_YMM1_YMM1_091h),  255,         RM_REG, T_AVX2_256, YMM1, YMM1,  NOREG, PASS_ARRAY(s_aValues91) },
        {  BS3_INSTR3_ALL(vpermpd_YMM1_YMM1_0E7h),  255,         RM_REG, T_AVX2_256, YMM1, YMM1,  NOREG, PASS_ARRAY(s_aValuesE7) },
    };
    return bs3CpuInstr3_WorkerTestType1(bMode, PASS_ARRAY(s_aTests), PASS_ARRAY(g_aXcptConfig4));
}


/*
 * MASKMOVQ, [V]MASKMOVDQU - move selected bytes
 */
BS3_DECL_FAR(uint8_t) bs3CpuInstr3_maskmovq_v_maskmovdqu(uint8_t bMode)
{
    static BS3CPUINSTR3_TEST1_VALUES_T const s_aValues[] =
    {
        {   /*src2*/ RTUINT256_INIT_C(0, 0, 0x0000000000000000, 0x0000000000000000),   /* mask */
            /*src1*/ RTUINT256_INIT_C(0, 0, 0x9192939495969798, 0xfedcba9876543210),   /*  src */
            /* => */ RTUINT256_INIT_C(0, 0, 0xcccccccccccccccc, 0xcccccccccccccccc) }, /* dest */
        {   /*src2*/ RTUINT256_INIT_C(0, 0, 0x89abcdeffedcba98, 0xffeeddccbbaa9988),
            /*src1*/ RTUINT256_INIT_C(0, 0, 0x9192939495969798, 0xfedcba9876543210),
            /* => */ RTUINT256_INIT_C(0, 0, 0x9192939495969798, 0xfedcba9876543210) },
        {   /*src2*/ RTUINT256_INIT_C(0, 0, 0x10204080c0e0f0ff, 0x8000800080008000),
            /*src1*/ RTUINT256_INIT_C(0, 0, 0x9192939495969798, 0xfedcba9876543210),
            /* => */ RTUINT256_INIT_C(0, 0, 0xcccccc9495969798, 0xfeccbacc76cc32cc) },
    };

    static BS3CPUINSTR3_TEST1_T const s_aTests[] =
    {
        {  BS3_INSTR3_ALL(maskmovq_MM0_MM1),      255,         RM_MEM_DI, T_MMX_SSE, 255, MM0,  MM1,  PASS_ARRAY(s_aValues) },
        {  BS3_INSTR3_ALL(maskmovdqu_XMM0_XMM1),  255,         RM_MEM_DI, T_SSE2,    255, XMM0, XMM1, PASS_ARRAY(s_aValues) },
        {  BS3_INSTR3_ALL(vmaskmovdqu_XMM0_XMM1), X86_XCPT_AC, RM_MEM_DI, T_AVX_128, 255, XMM0, XMM1, PASS_ARRAY(s_aValues) },

        {  BS3_INSTR3_C64(maskmovdqu_XMM8_XMM9),  255,         RM_MEM_DI, T_SSE2,    255, XMM8, XMM9, PASS_ARRAY(s_aValues) },
        {  BS3_INSTR3_C64(vmaskmovdqu_XMM8_XMM9), X86_XCPT_AC, RM_MEM_DI, T_AVX_128, 255, XMM8, XMM9, PASS_ARRAY(s_aValues) },
    };
    return bs3CpuInstr3_WorkerTestType1(bMode, PASS_ARRAY(s_aTests), PASS_ARRAY(g_aXcptConfig5));
}


/*
 * [V]PMADDWD  - Multiply and add packed signed word integers.
 */
BS3_DECL_FAR(uint8_t) bs3CpuInstr3_v_pmaddwd(uint8_t bMode)
{
    static BS3CPUINSTR3_TEST1_VALUES_T const s_aValues64W[] =
    {
        {   /*src2*/ RTUINT256_INIT_C(0, 0, 0, 0),
            /*src1*/ RTUINT256_INIT_C(0, 0, 0, 0),
            /* => */ RTUINT256_INIT_C(0, 0, 0, 0) },
        {   /*src2*/ RTUINT256_INIT_C(0xf1f2f3f4f5f6f7f8, 0xe1e2e3e4e5e6e7e8, 0xd1d2d3d4d5d6d7d8, 0xc1c2c3c4c5c6c7c8),
            /*src1*/ RTUINT256_INIT_C(0xb1b2b3b4b5b6b7b8, 0xa1a2a3a4a5a6a7a8, 0x9192939495969798, 0x8182838485868788),
            /* => */ RTUINT256_INIT_C(                 1,                  2,                  3, 0x3c0b6394364ffde4) },
        {   /*src2*/ RTUINT256_INIT_C(0x4d09f02a6cdc73d5, 0x3ef417c8666b3fe6, 0xb4212fa8564c9ba2, 0x9c5ce073930996bb),
            /*src1*/ RTUINT256_INIT_C(0x1eddddac09633294, 0xf95c8eec40725633, 0x8800e95bbf9962c3, 0x43d3cda0238499fd),
            /* => */ RTUINT256_INIT_C(                 5,                  6,                  7, 0xebcf52b41ad4c573) },
    };
    static BS3CPUINSTR3_TEST1_VALUES_T const s_aValues128W[] =
    {
        {   /*src2*/ RTUINT256_INIT_C(0, 0, 0, 0),
            /*src1*/ RTUINT256_INIT_C(0, 0, 0, 0),
            /* => */ RTUINT256_INIT_C(0, 0, 0, 0) },
        {   /*src2*/ RTUINT256_INIT_C(0xf1f2f3f4f5f6f7f8, 0xe1e2e3e4e5e6e7e8, 0xd1d2d3d4d5d6d7d8, 0xc1c2c3c4c5c6c7c8),
            /*src1*/ RTUINT256_INIT_C(0xb1b2b3b4b5b6b7b8, 0xa1a2a3a4a5a6a7a8, 0x9192939495969798, 0x8182838485868788),
            /* => */ RTUINT256_INIT_C(                 9,                 10, 0x26a0ce5421e769a4, 0x3c0b6394364ffde4) },
        {   /*src2*/ RTUINT256_INIT_C(0x4d09f02a6cdc73d5, 0x3ef417c8666b3fe6, 0xb4212fa8564c9ba2, 0x9c5ce073930996bb),
            /*src1*/ RTUINT256_INIT_C(0x1eddddac09633294, 0xf95c8eec40725633, 0x8800e95bbf9962c3, 0x43d3cda0238499fd),
            /* => */ RTUINT256_INIT_C(                13,                 14, 0x1f5960b8c391d7d2, 0xebcf52b41ad4c573) },
    };
    static BS3CPUINSTR3_TEST1_VALUES_T const s_aValues256W[] =
    {
        {   /*src2*/ RTUINT256_INIT_C(0, 0, 0, 0),
            /*src1*/ RTUINT256_INIT_C(0, 0, 0, 0),
            /* => */ RTUINT256_INIT_C(0, 0, 0, 0) },
        {   /*src2*/ RTUINT256_INIT_C(0xf1f2f3f4f5f6f7f8, 0xe1e2e3e4e5e6e7e8, 0xd1d2d3d4d5d6d7d8, 0xc1c2c3c4c5c6c7c8),
            /*src1*/ RTUINT256_INIT_C(0xb1b2b3b4b5b6b7b8, 0xa1a2a3a4a5a6a7a8, 0x9192939495969798, 0x8182838485868788),
            /* => */ RTUINT256_INIT_C(0x07e3afd4052e4d24, 0x153e3d141186d964, 0x26a0ce5421e769a4, 0x3c0b6394364ffde4) },
        {   /*src2*/ RTUINT256_INIT_C(0x4d09f02a6cdc73d5, 0x3ef417c880008000, 0xb4212fa8564c9ba2, 0x9c5ce073930996bb),
            /*src1*/ RTUINT256_INIT_C(0x1eddddac09633294, 0xf95c8eec80008000, 0x8800e95bbf9962c3, 0x43d3cda0238499fd),
            /* => */ RTUINT256_INIT_C(0x0b692cfd1ae06638, 0xf3dcd01080000000, 0x1f5960b8c391d7d2, 0xebcf52b41ad4c573) },
    };

    static BS3CPUINSTR3_TEST1_T const s_aTests[] =
    {
        {  BS3_INSTR3_ALL(pmaddwd_MM1_MM2),          255,         RM_REG, T_MMX,      MM1,  MM1,  MM2,   PASS_ARRAY(s_aValues64W)  },
        {  BS3_INSTR3_ALL(pmaddwd_MM1_FSxBX),        255,         RM_MEM, T_MMX,      MM1,  MM1,  FSxBX, PASS_ARRAY(s_aValues64W)  },
        {  BS3_INSTR3_ALL(pmaddwd_XMM1_XMM2),        255,         RM_REG, T_SSE2,     XMM1, XMM1, XMM2,  PASS_ARRAY(s_aValues128W) },
        {  BS3_INSTR3_ALL(pmaddwd_XMM1_FSxBX),       255,         RM_MEM, T_SSE2,     XMM1, XMM1, FSxBX, PASS_ARRAY(s_aValues128W) },
        {  BS3_INSTR3_C64(pmaddwd_XMM8_XMM9),        255,         RM_REG, T_SSE2,     XMM8, XMM8, XMM9,  PASS_ARRAY(s_aValues128W) },
        {  BS3_INSTR3_C64(pmaddwd_XMM8_FSxBX),       255,         RM_MEM, T_SSE2,     XMM8, XMM8, FSxBX, PASS_ARRAY(s_aValues128W) },
        {  BS3_INSTR3_ALL(vpmaddwd_XMM1_XMM2_XMM3),  255,         RM_REG, T_AVX_128,  XMM1, XMM2, XMM3,  PASS_ARRAY(s_aValues128W) },
        {  BS3_INSTR3_ALL(vpmaddwd_XMM1_XMM2_FSxBX), X86_XCPT_DB, RM_MEM, T_AVX_128,  XMM1, XMM2, FSxBX, PASS_ARRAY(s_aValues128W) },
        {  BS3_INSTR3_C64(vpmaddwd_XMM8_XMM9_XMM10), 255,         RM_REG, T_AVX_128,  XMM8, XMM9, XMM10, PASS_ARRAY(s_aValues128W) },
        {  BS3_INSTR3_C64(vpmaddwd_XMM8_XMM9_FSxBX), X86_XCPT_DB, RM_MEM, T_AVX_128,  XMM8, XMM9, FSxBX, PASS_ARRAY(s_aValues128W) },
        {  BS3_INSTR3_ALL(vpmaddwd_YMM1_YMM2_YMM3),  255,         RM_REG, T_AVX2_256, YMM1, YMM2, YMM3,  PASS_ARRAY(s_aValues256W) },
        {  BS3_INSTR3_ALL(vpmaddwd_YMM1_YMM2_FSxBX), X86_XCPT_DB, RM_MEM, T_AVX2_256, YMM1, YMM2, FSxBX, PASS_ARRAY(s_aValues256W) },
        {  BS3_INSTR3_C64(vpmaddwd_YMM8_YMM9_YMM10), 255,         RM_REG, T_AVX2_256, YMM8, YMM9, YMM10, PASS_ARRAY(s_aValues256W) },
        {  BS3_INSTR3_C64(vpmaddwd_YMM8_YMM9_FSxBX), X86_XCPT_DB, RM_MEM, T_AVX2_256, YMM8, YMM9, FSxBX, PASS_ARRAY(s_aValues256W) },
    };
    return bs3CpuInstr3_WorkerTestType1(bMode, PASS_ARRAY(s_aTests), PASS_ARRAY(g_aXcptConfig4));
}


/*
 * Test type #2 - GPR <- MM/XMM/YMM, no VVVV.
 */

typedef struct BS3CPUINSTR3_TEST2_VALUES_T
{
    RTUINT256U      uSrc;
    uint64_t        uDstOut;
} BS3CPUINSTR3_TEST2_VALUES_T;

typedef struct BS3CPUINSTR3_TEST2_T
{
    FPFNBS3FAR      pfnWorker_16;        /**< Test function worker for 16-bit execution modes. */
    FPFNBS3FAR      pfnWorker_32;        /**< Test function worker for 32-bit execution modes. */
    FPFNBS3FAR      pfnWorker_64;        /**< Test function worker for 64-bit execution modes. */
    uint8_t         bAltXcpt;            /**< AVX misalignment exception, or always-expected exception. */
    uint8_t         enmRm;
    uint8_t         enmType;
    uint8_t         cbGpr;
    uint8_t         iRegDst;
    uint8_t         iRegSrc;
    uint8_t         cValues;
    BS3CPUINSTR3_TEST2_VALUES_T const BS3_FAR *paValues;
} BS3CPUINSTR3_TEST2_T;

typedef struct BS3CPUINSTR3_TEST2_MODE_T
{
    BS3CPUINSTR3_TEST2_T const BS3_FAR *paTests;
    unsigned                            cTests;
} BS3CPUINSTR3_TEST2_MODE_T;

/** Initializer for a BS3CPUINSTR3_TEST2_MODE_T array (three entries). */
#define BS3CPUINSTR3_TEST2_MODES_INIT(a_aTests16, a_aTests32, a_aTests64) \
    { { a_aTests16, RT_ELEMENTS(a_aTests16) }, { a_aTests32, RT_ELEMENTS(a_aTests32) }, { a_aTests64, RT_ELEMENTS(a_aTests64) } }


/**
 * Test type #2 worker.
 */
static uint8_t bs3CpuInstr3_WorkerTestType2(uint8_t bMode, unsigned cTests, BS3CPUINSTR3_TEST2_T const BS3_FAR *paTests,
                                            unsigned cConfigs, PCBS3CPUINSTR3_CONFIG_T paConfigs)
{
    BS3REGCTX                   Ctx;
    BS3TRAPFRAME                TrapFrame;
    const char BS3_FAR * const  pszMode = Bs3GetModeName(bMode);
    uint8_t BS3_FAR            *pbBuf   = g_pbBuf;
    uint32_t                    cbBuf   = g_cbBuf;
    uint8_t                     bRing   = BS3_MODE_IS_V86(bMode) ? 3 : 0;
    PBS3EXTCTX                  pExtCtxOut;
    PBS3EXTCTX                  pExtCtx = bs3CpuInstr3AllocExtCtxs(&pExtCtxOut);
    BS3SETREGCTX                SetRegCtx;
    if (!pExtCtx)
        return 0;

    /* Ensure the structures are allocated before we sample the stack pointer. */
    Bs3MemSet(&Ctx, 0, sizeof(Ctx));
    Bs3MemSet(&TrapFrame, 0, sizeof(TrapFrame));

    /*
     * Create test context.
     */
    pbBuf = bs3CpuInstr3BufSetup(pbBuf, &cbBuf, bMode);
    Bs3RegCtxSaveForMode(&Ctx, bMode, 1024);
    bs3CpuInstr3SetupSseAndAvx(&Ctx, pExtCtx);

    bs3CpuInstrXGetRegisterInit(&SetRegCtx, pExtCtx, &Ctx, bMode);

    /*
     * Run the tests in all rings since alignment issues may behave
     * differently in ring-3 compared to ring-0.
     */
    for (;;)
    {
        unsigned fPf = 0;
        do
        {
            unsigned iCfg;
            for (iCfg = 0; iCfg < cConfigs; iCfg++)
            {
                unsigned                    iTest;
                BS3CPUINSTR3_CONFIG_SAVED_T SavedCfg;
                if (!bs3CpuInstr3ConfigReconfigure(&SavedCfg, &Ctx, pExtCtx, &paConfigs[iCfg], bMode))
                    continue; /* unsupported config */

                /*
                 * Iterate the tests.
                 */
                for (iTest = 0; iTest < cTests; iTest++)
                {
                    BS3CPUINSTR3_TEST2_VALUES_T const BS3_FAR *paValues = paTests[iTest].paValues;
                    FPFNBS3FAR const pfnWorker  = BS3_MODE_IS_16BIT_CODE(bMode) ? paTests[iTest].pfnWorker_16
                                                : BS3_MODE_IS_32BIT_CODE(bMode) ? paTests[iTest].pfnWorker_32
                                                                                : paTests[iTest].pfnWorker_64;
                    uint8_t const   cbInstr     = ((uint8_t const BS3_FAR *)(uintptr_t)pfnWorker)[-1];
                    unsigned const  cValues     = paTests[iTest].cValues;
                    bool const      fMmxInstr   = paTests[iTest].enmType < T_SSE;
                    bool const      fSseInstr   = paTests[iTest].enmType >= T_SSE && paTests[iTest].enmType < T_AVX_128;
                    bool const      fAvxInstr   = paTests[iTest].enmType >= T_AVX_128;
                    bool const      fMemOp      = paTests[iTest].enmRm >= RM_MEM;
                    uint8_t const   cMemOps     = BS3_REGISTER_IS_MEMREF(paTests[iTest].iRegDst)
                                                + BS3_REGISTER_IS_MEMREF(paTests[iTest].iRegSrc);
                    uint8_t const   cbOperand   = paTests[iTest].enmType < T_128BITS ? 64/8
                                                : paTests[iTest].enmType < T_256BITS ? 128/8 : 256/8;
                    uint8_t const   cbMemOp     = bs3CpuInstr3MemOpSize(cbOperand, paTests[iTest].enmRm);
                    uint8_t const   cbAlign     = RT_MIN(cbOperand, 16);
                    bool const      fRipRel     = paTests[iTest].iRegDst == RIPREL || paTests[iTest].iRegSrc == RIPREL;
                    PRTUINT256U     puMemOp     = fRipRel ? bs3CpuInstr3RipRelOperand()
                                                : bs3CpuInstr3BufForOperand(pbBuf, cbBuf, cbMemOp, cbAlign, &paConfigs[iCfg], fPf);
                    PRTUINT256U     puMemOpAlias = fRipRel ? puMemOp : (PRTUINT256U)&g_pbBufAlias[(uintptr_t)puMemOp - (uintptr_t)pbBuf];
                    uint8_t         bXcptExpect = !g_afTypeSupports[paTests[iTest].enmType] ? X86_XCPT_UD
                                                : paTests[iTest].bAltXcpt & BS3_XCPT_ALWAYS && paTests[iTest].bAltXcpt != 255 ? paTests[iTest].bAltXcpt & ~BS3_XCPT_ALWAYS
                                                : fMmxInstr ? paConfigs[iCfg].bXcptMmx
                                                : fSseInstr ? paConfigs[iCfg].bXcptSse
                                                : BS3_MODE_IS_RM_OR_V86(bMode) ? X86_XCPT_UD : paConfigs[iCfg].bXcptAvx;
                    uint16_t        idTestStep  = bRing * 10000 + iCfg * 100 + iTest * 10;
                    unsigned        cRecompRuns = 0;
                    unsigned const  cMaxRecompRuns = g_cBs3ThresholdNativeRecompiler + cValues;
                    unsigned        iVal;

                    /* Some tests are for specific modes only. */
                    if (!pfnWorker)
                        continue;

                    /* If testing unaligned memory accesses (or #PF), skip register-only tests.  This
                       allows setting bXcptMmx, bXcptSse and bXcptAvx to reflect the misaligned exceptions.
                       Same for RIP relative operands, they always use the same aligned buffer.  */
                    if ((paTests[iTest].enmRm == RM_REG || paTests[iTest].enmRm == RM_MEM8 || fRipRel) && (!paConfigs[iCfg].fAligned || paConfigs[iCfg].fAlignCheck || fPf))
                        continue;

                    BS3_ASSERT((fMemOp && (cMemOps == 1)) || (!fMemOp && (cMemOps == 0)));
                    NOREF(cMemOps);

                    /* #AC is only raised in ring-3.: */
                    if (bXcptExpect == X86_XCPT_AC)
                    {
                        if (bRing != 3)
                            bXcptExpect = X86_XCPT_DB;
                        else if (fAvxInstr)
                            bXcptExpect = paTests[iTest].bAltXcpt; /* they generally don't raise #AC */
                    }

                    if (fPf && bXcptExpect == X86_XCPT_DB)
                        bXcptExpect = X86_XCPT_PF;

                    Bs3RegCtxSetRipCsFromCurPtr(&Ctx, pfnWorker);

                    if (BS3_SKIPIT((cMaxRecompRuns + cValues - 1) / cValues * cValues, 0))
                        continue;

                    /*
                     * Iterate the test values and do the actual testing.
                     */
                    while (cRecompRuns < cMaxRecompRuns)
                        for (iVal = 0; iVal < cValues; iVal++, idTestStep++, cRecompRuns++)
                        {
                            uint16_t   cErrors;
                            uint16_t   uSavedFtw = 0xff;
                            RTUINT256U uMemOpExpect;
                            RTUINT256U uDstVal = RTUINT256_INIT_C(0, 0, 0, 0);

                            if (BS3_SKIPIT(1, 1)) continue;

                            /*
                             * Set up the context and some expectations.
                             */
                            SetRegCtx.enmTop = BS3EXTCTXTOPMM_ZERO;
                            if (fRipRel)
                                bs3CpuInstr3RipRelInit();

                            Bs3MemCpy(&uDstVal, &paValues[iVal].uDstOut, paTests[iTest].cbGpr);

                            /* dest */
                            if (BS3_REGISTER_IS_MEMREF(paTests[iTest].iRegDst))
                            {
                                Bs3MemSet(puMemOpAlias, 0xcc, cbMemOp);
                                if (bXcptExpect == X86_XCPT_DB)
                                    uMemOpExpect = uDstVal;
                                else
                                    Bs3MemSet(&uMemOpExpect, 0xcc, sizeof(uMemOpExpect));
                            }

                            /* source */
                            if (BS3_REGISTER_IS_MEMREF(paTests[iTest].iRegSrc))
                            {
                                Bs3MemCpy(puMemOpAlias, &paValues[iVal].uSrc, cbMemOp);
                                uMemOpExpect = paValues[iVal].uSrc;
                            }
                            else
                                Bs3ExtCtxSetReg(&SetRegCtx, paTests[iTest].iRegSrc, &paValues[iVal].uSrc);

                            /* Memory pointer (RIP relative operands need none). */
                            if (fMemOp && !fRipRel)
                                Bs3ExtCtxSetReg(&SetRegCtx, (paTests[iTest].enmRm == RM_MEM_DI) ? FSxDI : FSxBX, (void *)puMemOp);

                            /*
                             * Execute.
                             */
                            g_uBs3TrapEipHint = Ctx.rip.u32 + (bXcptExpect == X86_XCPT_DB ? cbInstr + 1 : 0);
                            Bs3TrapSetJmpAndRestoreWithExtCtxAndRm(&Ctx, pExtCtx, &TrapFrame, pExtCtxOut);

                            /*
                             * Check the result:
                             */
                            cErrors = Bs3TestSubErrorCount();

                            if (fMmxInstr && bXcptExpect == X86_XCPT_DB)
                            {
                                uSavedFtw = Bs3ExtCtxGetAbridgedFtw(pExtCtx);
                                Bs3ExtCtxSetAbridgedFtw(pExtCtx, 0xff);
                            }

                            SetRegCtx.enmTop = BS3EXTCTXTOPMM_SET;
                            if (bXcptExpect == X86_XCPT_DB && !BS3_REGISTER_IS_MEMREF(paTests[iTest].iRegDst))
                                Bs3ExtCtxSetReg(&SetRegCtx, paTests[iTest].iRegDst, &uDstVal);

                            Bs3TestCheckExtCtx(pExtCtxOut, pExtCtx, 0 /*fFlags*/, pszMode, idTestStep);

                            if (TrapFrame.bXcpt != bXcptExpect)
                                Bs3TestFailedF("Expected bXcpt = %#x, got %#x", bXcptExpect, TrapFrame.bXcpt);

                            /* Kludge! Looks like EFLAGS.AC is cleared when raising #GP in real mode on the 10980XE. WEIRD! */
                            if (bMode == BS3_MODE_RM && (Ctx.rflags.u32 & X86_EFL_AC))
                            {
                                if (TrapFrame.Ctx.rflags.u32 & X86_EFL_AC)
                                    Bs3TestFailedF("Expected EFLAGS.AC to be cleared (bXcpt=%d)", TrapFrame.bXcpt);
                                TrapFrame.Ctx.rflags.u32 |= X86_EFL_AC;
                            }
                            if (bXcptExpect == X86_XCPT_PF)
                                Ctx.cr2.u = (uintptr_t)puMemOp;
                            Bs3TestCheckRegCtxEx(&TrapFrame.Ctx, &Ctx, bXcptExpect == X86_XCPT_DB ? cbInstr + 1 : 0, 0,
                                                 bXcptExpect == X86_XCPT_DB || BS3_MODE_IS_16BIT_SYS(bMode) ? 0 : X86_EFL_RF,
                                                 pszMode, idTestStep);
                            Ctx.cr2.u = 0;

                            if (   fMemOp
                                && Bs3MemCmp(puMemOpAlias, &uMemOpExpect, cbMemOp) != 0)
                                Bs3TestFailedF("Expected uMemOp %.*Rhxs, got %.*Rhxs", cbMemOp, &uMemOpExpect, cbMemOp, puMemOpAlias);

                            if (fRipRel)
                                bs3CpuInstr3RipRelCheckGuards(cbMemOp);

                            if (cErrors != Bs3TestSubErrorCount())
                            {
                                if (paConfigs[iCfg].fAligned)
                                    Bs3TestFailedF("ring-%d/cfg#%u/test#%u/value#%u failed (bXcptExpect=%#x)",
                                                   bRing, iCfg, iTest, iVal, bXcptExpect);
                                else
                                    Bs3TestFailedF("ring-%d/cfg#%u/test#%u/value#%u failed (bXcptExpect=%#x, puMemOp=%p, EFLAGS=%#RX32, CR0=%#RX32)",
                                                   bRing, iCfg, iTest, iVal, bXcptExpect, puMemOp, TrapFrame.Ctx.rflags.u32, TrapFrame.Ctx.cr0);
                                Bs3TestPrintf("\n");
                            }

                            if (uSavedFtw != 0xff)
                                Bs3ExtCtxSetAbridgedFtw(pExtCtx, uSavedFtw);
                        }
                }

                bs3CpuInstr3ConfigRestore(&SavedCfg, &Ctx, pExtCtx);
            }
        } while (fPf++ == 0 && BS3_MODE_IS_PAGED(bMode));

        /*
         * Next ring.
         */
        bRing++;
        if (bRing > 3 || bMode == BS3_MODE_RM)
            break;
        Bs3RegCtxConvertToRingX(&Ctx, bRing);
    }

    /*
     * Cleanup.
     */
    bs3CpuInstr3BufCleanup(pbBuf, cbBuf, bMode);
    bs3CpuInstr3FreeExtCtxs(pExtCtx, pExtCtxOut);
    return 0;
}


