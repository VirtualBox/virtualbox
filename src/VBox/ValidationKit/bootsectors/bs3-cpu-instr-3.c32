        {  BS3_INSTR3_C64(vpinsrq_XMM1_XMM2_RDX_000h),   255,         RM_REG,   T_AVX_128, 8, XMM1, XMM2, RDX,   PASS_ARRAY(s_aValues00_q)    },
        {  BS3_INSTR3_C64(vpinsrq_XMM1_XMM2_FSxBX_000h), X86_XCPT_AC, RM_MEM64, T_AVX_128, 8, XMM1, XMM2, FSxBX, PASS_ARRAY(s_aValues00_q)    },

