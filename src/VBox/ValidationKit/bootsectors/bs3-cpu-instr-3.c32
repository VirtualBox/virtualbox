        {  BS3_INSTR3_C64(vblendvps_YMM8_YMM9_FSxBX_YMM11),  X86_XCPT_DB, RM_MEM, T_AVX_256,  YMM8, YMM9, FSxBX, YMM11, PASS_ARRAY(s_aValues) },
        {  BS3_INSTR3_C64(vblendvps_YMM8_YMM9_RIPREL_YMM11), X86_XCPT_DB, RM_MEM, T_AVX_256,  YMM8, YMM9, RIPREL, YMM11, PASS_ARRAY(s_aValues) },
    };
    return bs3CpuInstr3_WorkerTestType5(bMode, PASS_ARRAY(s_aTests), PASS_ARRAY(g_aXcptConfig4));
}


