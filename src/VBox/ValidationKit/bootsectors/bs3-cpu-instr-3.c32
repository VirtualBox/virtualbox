        {  BS3_INSTR3_ALL(vmovq_FSxBX_XMM1),     X86_XCPT_AC, RM_MEM64, T_AVX_128, 8, FSxBX, XMM1,  PASS_ARRAY(s_aValuesRm)     },
        {  BS3_INSTR3_386(07e_vmovq_FSxBX_XMM1), X86_XCPT_AC, RM_MEM32, T_AVX_128, 4, FSxBX, XMM1,  PASS_ARRAY(s_aValuesRm)     }, /* VEX.W! */
