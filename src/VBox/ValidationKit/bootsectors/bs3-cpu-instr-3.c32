            /* => */ RTUINT256_INIT_C(0xb1b2b3b4b5b6b7b8, 0xa1a2a3a4a5a6a7a8, 0x9192939495969798, 0x8182838485868788) }, /* straight copy */
    };
    static BS3CPUINSTR3_TEST1_VALUES_T const s_aValues3D[] =
