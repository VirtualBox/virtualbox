        {  BS3_INSTR3_ALL(vpermilps_XMM1_FSxBX_03Dh), X86_XCPT_DB, RM_MEM, T_AVX_128, XMM1, FSxBX, NOREG, PASS_ARRAY(s_aValues3D)  },
        {  BS3_INSTR3_ALL(vpermilps_YMM1_YMM2_YMM3),  255,         RM_REG, T_AVX_256, YMM1, YMM2,  YMM3,  PASS_ARRAY(s_aValuesAll) },
        {  BS3_INSTR3_ALL(vpermilps_YMM1_YMM2_FSxBX), X86_XCPT_DB, RM_MEM, T_AVX_256, YMM1, YMM2,  FSxBX, PASS_ARRAY(s_aValuesAll) },
        {  BS3_INSTR3_ALL(vpermilps_YMM1_YMM2_000h),  255,         RM_REG, T_AVX_256, YMM1, YMM2,  NOREG, PASS_ARRAY(s_aValues00)  },
        {  BS3_INSTR3_ALL(vpermilps_YMM1_YMM2_01Bh),  255,         RM_REG, T_AVX_256, YMM1, YMM2,  NOREG, PASS_ARRAY(s_aValues1B)  },
        {  BS3_INSTR3_ALL(vpermilps_YMM1_YMM2_0E4h),  255,         RM_REG, T_AVX_256, YMM1, YMM2,  NOREG, PASS_ARRAY(s_aValuesE4)  },
        {  BS3_INSTR3_ALL(vpermilps_YMM1_YMM2_03Dh),  255,         RM_REG, T_AVX_256, YMM1, YMM2,  NOREG, PASS_ARRAY(s_aValues3D)  },
        {  BS3_INSTR3_ALL(vpermilps_YMM1_FSxBX_000h), X86_XCPT_DB, RM_MEM, T_AVX_256, YMM1, FSxBX, NOREG, PASS_ARRAY(s_aValues00)  },
