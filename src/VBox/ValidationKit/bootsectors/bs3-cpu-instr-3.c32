        {  BS3_INSTR3_ALL(vpermilps_XMM1_XMM2_03Dh),  255,         RM_REG, T_AVX_128, XMM1, XMM2,  NOREG, PASS_ARRAY(s_aValues3D)  },
        {  BS3_INSTR3_ALL(vpermilps_XMM1_FSxBX_000h), X86_XCPT_DB, RM_MEM, T_AVX_128, XMM1, FSxBX, NOREG, PASS_ARRAY(s_aValues00)  },
