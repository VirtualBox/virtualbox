/*
 * VPERMD - Permute Doubleword Values
 * VPERMPS - Permute Single Precision Floating-Point Values
 */
BS3_DECL_FAR(uint8_t) bs3CpuInstr3_vpermd_vpermps(uint8_t bMode)
{
    static BS3CPUINSTR3_TEST1_VALUES_T const s_aValues[] =
    {
        {   /*src2*/ RTUINT256_INIT_C(0xf0e1d2c3eeddccbb, 0x1234567880806502, 0x6809400453589793, 0xfaf0f00f31415926),
            /*src1*/ RTUINT256_INIT_C(0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000),
            /* => */ RTUINT256_INIT_C(0x3141592631415926, 0x3141592631415926, 0x3141592631415926, 0x3141592631415926) }, /* lo => all 8 slots */
        {   /*src2*/ RTUINT256_INIT_C(0xf0e1d2c3eeddccbb, 0x1234567880806502, 0x6809400453589793, 0xfaf0f00f31415926),
            /*src1*/ RTUINT256_INIT_C(0x0000000000000001, 0x0000000200000000, 0x0000000000000005, 0x0000000600000007),
            /* => */ RTUINT256_INIT_C(0x31415926faf0f00f, 0x5358979331415926, 0x3141592612345678, 0xeeddccbbf0e1d2c3) }, /* backwards except middle 2 = lo */
        {   /*src2*/ RTUINT256_INIT_C(0xf0e1d2c3eeddccbb, 0x1234567880806502, 0x6809400453589793, 0xfaf0f00f31415926),
            /*src1*/ RTUINT256_INIT_C(0x013456789abcdef2, 0x1236789abcdef045, 0x23456abcdef01789, 0x345678def0129abc),
            /* => */ RTUINT256_INIT_C(0x3141592653589793, 0x5358979312345678, 0x80806502faf0f00f, 0xeeddccbb80806502) }, /* assorted */
    };
    static BS3CPUINSTR3_TEST1_VALUES_T const s_aValuesSR[] =
    {
        {   /*igno*/ RTUINT256_INIT_C(0, 0, 0, 0),
            /*src1*/ RTUINT256_INIT_C(0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000),
            /* => */ RTUINT256_INIT_C(0x0000000000000000, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000) },
        {   /*igno*/ RTUINT256_INIT_C(0, 0, 0, 0),
            /*src1*/ RTUINT256_INIT_C(0x0000000000000001, 0x0000000200000000, 0x0000000000000005, 0x0000000600000007),
            /* => */ RTUINT256_INIT_C(0x0000000700000006, 0x0000000500000007, 0x0000000700000002, 0x0000000100000000) },
        {   /*igno*/ RTUINT256_INIT_C(0, 0, 0, 0),
            /*src1*/ RTUINT256_INIT_C(0x013456789abcdef2, 0x1236789abcdef045, 0x23456abcdef01789, 0x345678def0129abc),
            /* => */ RTUINT256_INIT_C(0xf0129abcdef01789, 0xdef017891236789a, 0xbcdef045345678de, 0x9abcdef2bcdef045) },
    };

    static BS3CPUINSTR3_TEST1_T const s_aTests[] =
    {
        {  BS3_INSTR3_ALL(vpermd_YMM1_YMM2_YMM3),   255,         RM_REG, T_AVX2_256, YMM1, YMM2, YMM3,  PASS_ARRAY(s_aValues)   },
        {  BS3_INSTR3_ALL(vpermd_YMM1_YMM2_FSxBX),  X86_XCPT_DB, RM_MEM, T_AVX2_256, YMM1, YMM2, FSxBX, PASS_ARRAY(s_aValues)   },

        {  BS3_INSTR3_C64(vpermd_YMM8_YMM9_YMM10),  255,         RM_REG, T_AVX2_256, YMM8, YMM9, YMM10, PASS_ARRAY(s_aValues)   },
