            /*src1*/ RTUINT256_INIT_C(0, 0x70bacc00707a11ed, 0x70bacc00707a11ed, 0),
            /* => */ { 0, X86_EFL_ZF | X86_EFL_CF, X86_EFL_ZF } },
        {   /*src2*/ RTUINT256_INIT_C(0xcafec01dea7e5ef, 0x8f6f6ff080608fff, 0xefdb0f5fe793f600, 0x99fb1c399ff0cce),
            /*src1*/ RTUINT256_INIT_C(0, 0x8ff7123497dcaeb4, 0, 0xd0d0c01dea7eeedf),
            /* => */ { 0, 0, 0 } },
    };

    static BS3CPUINSTR3_TEST4_T const s_aTests[] =
    {
        {  BS3_INSTR3_ALL(vtestps_XMM1_XMM2),  255,         RM_REG, T_AVX_128, XMM1, XMM2,  PASS_ARRAY(s_aValues) },
        {  BS3_INSTR3_ALL(vtestps_XMM1_FSxBX), X86_XCPT_DB, RM_MEM, T_AVX_128, XMM1, FSxBX, PASS_ARRAY(s_aValues) },
        {  BS3_INSTR3_ALL(vtestps_YMM1_YMM2),  255,         RM_REG, T_AVX_256, YMM1, YMM2,  PASS_ARRAY(s_aValues) },
        {  BS3_INSTR3_ALL(vtestps_YMM1_FSxBX), X86_XCPT_DB, RM_MEM, T_AVX_256, YMM1, FSxBX, PASS_ARRAY(s_aValues) },
        {  BS3_INSTR3_C64(vtestps_XMM9_XMM8),  255,         RM_REG, T_AVX_128, XMM9, XMM8,  PASS_ARRAY(s_aValues) },
        {  BS3_INSTR3_C64(vtestps_XMM9_FSxBX), X86_XCPT_DB, RM_MEM, T_AVX_128, XMM9, FSxBX, PASS_ARRAY(s_aValues) },
        {  BS3_INSTR3_C64(vtestps_YMM9_YMM8),  255,         RM_REG, T_AVX_256, YMM9, YMM8,  PASS_ARRAY(s_aValues) },
        {  BS3_INSTR3_C64(vtestps_YMM9_FSxBX), X86_XCPT_DB, RM_MEM, T_AVX_256, YMM9, FSxBX, PASS_ARRAY(s_aValues) },
    };
    return bs3CpuInstr3_WorkerTestType4(bMode, PASS_ARRAY(s_aTests), PASS_ARRAY(g_aXcptConfig4), X86_EFL_STATUS_BITS);
