        {  BS3_INSTR3_ALL(vblendvps_YMM1_YMM2_YMM3_YMM4),    255,         RM_REG, T_AVX_256,  YMM1, YMM2, YMM3,  YMM4,  PASS_ARRAY(s_aValues) },
