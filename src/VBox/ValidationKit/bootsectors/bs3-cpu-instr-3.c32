        {  BS3_INSTR3_ALL(vpgatherdd_XMM0_EBX_less_2_plus_XMM1_x_1_XMM2),   X86_XCPT_DB, -2,   T_AVX2_128, XMM0, EBX, XMM1, XMM2,  PASS_ARRAY(s_aValues32_32x1) },
