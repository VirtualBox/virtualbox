        {  BS3_INSTR3_ALL(vpgatherdd_XMM0_EBX_less_153_plus_XMM1_x_1_XMM2), X86_XCPT_DB, -153, T_AVX2_128, XMM0, EBX, XMM1, XMM2,  PASS_ARRAY(s_aValues32_32x1) },
        {  BS3_INSTR3_C64(vpgatherdd_XMM0_RBX_plus_0_plus_XMM1_x_1_XMM2),   X86_XCPT_DB, 0,    T_AVX2_128, XMM0, RBX, XMM1, XMM2,  PASS_ARRAY(s_aValues32_32x1) },
        {  BS3_INSTR3_C64(vpgatherdd_XMM8_R8D_plus_0_plus_XMM9_x_1_XMM10),  X86_XCPT_DB, 0,    T_AVX2_128, XMM8, R8D, XMM9, XMM10, PASS_ARRAY(s_aValues32_32x1) },
        {  BS3_INSTR3_ALL(vpgatherdd_YMM0_EBX_plus_0_plus_YMM0_x_1_YMM2),   X86_XCPT_UD, 0,    T_AVX2_256, YMM0, EBX, YMM0, YMM2,  PASS_ARRAY(s_aValuesUD)      },
        {  BS3_INSTR3_ALL(vpgatherdd_YMM0_EBX_plus_0_plus_YMM1_x_1_YMM0),   X86_XCPT_UD, 0,    T_AVX2_256, YMM0, EBX, YMM1, YMM0,  PASS_ARRAY(s_aValuesUD)      },
        {  BS3_INSTR3_ALL(vpgatherdd_YMM0_EBX_plus_0_plus_YMM1_x_1_YMM1),   X86_XCPT_UD, 0,    T_AVX2_256, YMM0, EBX, YMM1, YMM1,  PASS_ARRAY(s_aValuesUD)      },
        {  BS3_INSTR3_ALL(vpgatherdd_YMM0_EBX_plus_0_plus_YMM1_x_1_YMM2),   X86_XCPT_DB, 0,    T_AVX2_256, YMM0, EBX, YMM1, YMM2,  PASS_ARRAY(s_aValues32_32x1) },
        {  BS3_INSTR3_ALL(vpgatherdd_YMM0_EBX_plus_0_plus_YMM1_x_2_YMM2),   X86_XCPT_DB, 0,    T_AVX2_256, YMM0, EBX, YMM1, YMM2,  PASS_ARRAY(s_aValues32_32x2) },
        {  BS3_INSTR3_ALL(vpgatherdd_YMM0_EBX_plus_2_plus_YMM1_x_1_YMM2),   X86_XCPT_DB, 2,    T_AVX2_256, YMM0, EBX, YMM1, YMM2,  PASS_ARRAY(s_aValues32_32x1) },
        {  BS3_INSTR3_ALL(vpgatherdd_YMM0_EBX_less_2_plus_YMM1_x_1_YMM2),   X86_XCPT_DB, -2,   T_AVX2_256, YMM0, EBX, YMM1, YMM2,  PASS_ARRAY(s_aValues32_32x1) },
        {  BS3_INSTR3_ALL(vpgatherdd_YMM0_EBX_plus_153_plus_YMM1_x_1_YMM2), X86_XCPT_DB, 153,  T_AVX2_256, YMM0, EBX, YMM1, YMM2,  PASS_ARRAY(s_aValues32_32x1) },
        {  BS3_INSTR3_ALL(vpgatherdd_YMM0_EBX_less_153_plus_YMM1_x_1_YMM2), X86_XCPT_DB, -153, T_AVX2_256, YMM0, EBX, YMM1, YMM2,  PASS_ARRAY(s_aValues32_32x1) },
        {  BS3_INSTR3_C64(vpgatherdd_YMM0_RBX_plus_0_plus_YMM1_x_1_YMM2),   X86_XCPT_DB, 0,    T_AVX2_256, YMM0, RBX, YMM1, YMM2,  PASS_ARRAY(s_aValues32_32x1) },
        {  BS3_INSTR3_C64(vpgatherdd_YMM8_R8D_plus_0_plus_YMM9_x_1_YMM10),  X86_XCPT_DB, 0,    T_AVX2_256, YMM8, R8D, YMM9, YMM10, PASS_ARRAY(s_aValues32_32x1) },
    };
    return bs3CpuInstr3_WorkerTestType7(bMode, PASS_ARRAY(s_aTests), PASS_ARRAY(g_aXcptConfig5));
}


/*
 * VGATHERQPS - Gather Packed Single Precision FP Values Using Signed Qword Indices
 * VPGATHERQD - Gather Packed Dword Values Using Signed Qword Indices
 */
BS3_DECL_FAR(uint8_t) bs3CpuInstr3_vgatherqps_vpgatherqd(uint8_t bMode)
{
    static BS3CPUINSTR3_TEST7_VALUES_T const s_aValuesUD[] =
    { // Values don't matter, instruction is supposed to #UD!
        {
            /*mask*/ RTUINT256_INIT_C(0, 0, 0, 0),
            /*pmsk*/ RTUINT256_INIT_C(0, 0, 0, 0),
            /*offs*/ RTUINT256_INIT_C(0, 0, 0, 0),
            /*init*/ RTUINT256_INIT_C(0, 0, 0, 0),
            /* => */ RTUINT256_INIT_C(0, 0, 0, 0),
            /*flgs*/ 0 },
    };
    static BS3CPUINSTR3_TEST7_VALUES_T const s_aValues32_64x1X[] =
    { // 32-bit data slices and 64-bit indices times 1; only 2 indices (XMM's worth)
