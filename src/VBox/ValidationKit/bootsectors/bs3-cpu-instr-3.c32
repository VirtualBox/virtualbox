        {  BS3_INSTR3_C64(vmovq_FSxBX_XMM9),     X86_XCPT_AC, RM_MEM64, T_AVX_128, 8, FSxBX, XMM9,  PASS_ARRAY(s_aValuesRm)     },
        {  BS3_INSTR3_C64(07e_vmovq_FSxBX_XMM9), X86_XCPT_AC, RM_MEM64, T_AVX_128, 8, FSxBX, XMM9,  PASS_ARRAY(s_aValuesRm)     },
        {  BS3_INSTR3_ALL(vmovq_XMM1_XMM2),      255,         RM_REG,   T_AVX_128, 8, XMM1,  XMM2,  PASS_ARRAY(s_aValuesRm)     },
    };
    return bs3CpuInstr3_WorkerTestType2(bMode, PASS_ARRAY(s_aTests), PASS_ARRAY(g_aXcptConfig5));
}


