        {  BS3_INSTR3_C64(pmovmskb_EAX_dqword_FSxBX),  BS3_XCPT_UD, RM_MEM, T_SSE2,         8, EAX, FSxBX, PASS_ARRAY(s_aValues) },
        {  BS3_INSTR3_386(vpmovmskb_EAX_XMM2),         255,         RM_REG, T_AVX_128,      4, AX,  XMM2,  PASS_ARRAY(s_aValues) },
        {  BS3_INSTR3_C64(vpmovmskb_EAX_XMM2),         255,         RM_REG, T_AVX_128,      8, AX,  XMM2,  PASS_ARRAY(s_aValues) },
        {  BS3_INSTR3_386(vpmovmskb_EAX_dqword_FSxBX), BS3_XCPT_UD, RM_MEM, T_AVX_128,      4, EAX, FSxBX, PASS_ARRAY(s_aValues) },
        {  BS3_INSTR3_C64(vpmovmskb_EAX_dqword_FSxBX), BS3_XCPT_UD, RM_MEM, T_AVX_128,      8, EAX, FSxBX, PASS_ARRAY(s_aValues) },
        {  BS3_INSTR3_386(vpmovmskb_EAX_YMM2),         255,         RM_REG, T_AVX2_256,     4, EAX, YMM2,  PASS_ARRAY(s_aValues) },
        {  BS3_INSTR3_C64(vpmovmskb_EAX_YMM2),         255,         RM_REG, T_AVX2_256,     8, EAX, YMM2,  PASS_ARRAY(s_aValues) },
        {  BS3_INSTR3_386(vpmovmskb_EAX_qqword_FSxBX), BS3_XCPT_UD, RM_MEM, T_AVX2_256,     4, EAX, FSxBX, PASS_ARRAY(s_aValues) },
        {  BS3_INSTR3_C64(vpmovmskb_EAX_qqword_FSxBX), BS3_XCPT_UD, RM_MEM, T_AVX2_256,     8, EAX, FSxBX, PASS_ARRAY(s_aValues) },
        {  BS3_INSTR3_C64(vpmovmskb_RAX_YMM9),         255,         RM_REG, T_AVX2_256,     8, RAX, YMM9,  PASS_ARRAY(s_aValues) },
    };
    return bs3CpuInstr3_WorkerTestType2(bMode, PASS_ARRAY(s_aTests), PASS_ARRAY(g_aXcptConfig4));
}


